---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

const { siteTitleHref } = (Astro.locals as { starlightRoute: StarlightRouteData }).starlightRoute;
const root = siteTitleHref.endsWith('/') ? siteTitleHref : `${siteTitleHref}/`;
const navItems = [
  { label: 'Install', slug: 'install/' },
  { label: 'Evaluate', slug: 'evaluate-draupnir/' },
  { label: 'Clients', slug: 'zed/' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '/');
---

<div class="draupnir-header-shell draupnir-panel draupnir-panel--octagon">
  <div class="draupnir-brand sl-flex">
    <span class="draupnir-mark" aria-hidden="true"><i></i><i></i><i></i></span>
    <SiteTitle />
  </div>

  <nav class="draupnir-primary-nav print:hidden" aria-label="Primary">
    {
      navItems.map(({ label, slug }) => {
        const href = `${root}${slug}`;
        return <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>;
      })
    }
  </nav>

  <div class="draupnir-header-search sl-flex print:hidden"><Search /></div>
  <div class="draupnir-header-tools sl-hidden md:sl-flex print:hidden">
    <div class="sl-flex social-icons"><SocialIcons /></div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  @layer starlight.user {
    .draupnir-header-shell {
      display: grid;
      grid-template-columns: minmax(11rem, auto) minmax(8rem, 22rem) auto;
      align-items: center;
      gap: clamp(0.7rem, 1.6vw, var(--draupnir-space-6));
      height: 100%;
      max-width: 90rem;
      margin-inline: auto;
      padding: var(--draupnir-space-2) var(--draupnir-space-6);
    }

    .draupnir-header-shell::after {
      background: color-mix(in srgb, var(--draupnir-surface) 91%, transparent);
      box-shadow: 0 14px 38px rgb(10 22 38 / 0.11), inset 0 1px var(--draupnir-highlight);
      backdrop-filter: blur(18px) saturate(120%);
    }

    .draupnir-brand {
      align-items: center;
      gap: var(--draupnir-space-3);
      min-width: 0;
    }

    .draupnir-mark {
      position: relative;
      display: block;
      flex: 0 0 1.35rem;
      width: 1.35rem;
      height: 1.2rem;
    }

    .draupnir-mark i {
      position: absolute;
      inset-inline: 0;
      height: 0.24rem;
      background: var(--draupnir-steel);
      clip-path: polygon(0 0, 100% 0, 86% 100%, 14% 100%);
    }

    .draupnir-mark i:nth-child(1) { inset-block-start: 0; background: var(--draupnir-cobalt); }
    .draupnir-mark i:nth-child(2) { inset: 0.42rem 0.18rem auto; }
    .draupnir-mark i:nth-child(3) { inset: 0.83rem 0.34rem auto; }

    .draupnir-brand :global(.site-title) {
      color: var(--draupnir-ink);
      font-size: 1.375rem;
      font-weight: var(--draupnir-weight-bold);
      letter-spacing: var(--draupnir-tracking-wide);
      line-height: 1;
      text-transform: uppercase;
      transform: translateY(0.0625rem);
    }

    .draupnir-primary-nav {
      display: none;
      align-items: center;
      justify-content: center;
      gap: var(--draupnir-space-2);
    }

    .draupnir-primary-nav a {
      position: relative;
      padding: var(--draupnir-space-2) var(--draupnir-space-3);
      color: var(--draupnir-muted);
      font-family: var(--draupnir-font-mono);
      font-size: var(--draupnir-text-xs);
      font-weight: var(--draupnir-weight-semibold);
      letter-spacing: var(--draupnir-tracking-widest);
      text-decoration: none;
      text-transform: uppercase;
    }

    .draupnir-primary-nav a::after {
      position: absolute;
      inset: auto 0.68rem 0.22rem;
      height: 2px;
      background: var(--draupnir-cobalt);
      content: '';
      transform: scaleX(0);
      transition: transform 140ms ease;
    }

    .draupnir-primary-nav a:hover,
    .draupnir-primary-nav a:focus-visible,
    .draupnir-primary-nav a[aria-current='page'] { color: var(--draupnir-ink); }
    .draupnir-primary-nav a[aria-current='page']::after { transform: scaleX(1); }

    .draupnir-header-search {
      justify-self: end;
      width: clamp(14rem, 20vw, 24rem);
      min-width: 0;
    }
    .draupnir-header-search :global(button[data-open-modal]) { max-width: none; }
    .draupnir-header-tools,
    .social-icons { align-items: center; gap: var(--draupnir-space-3); }
    .draupnir-header-tools :global(starlight-theme-select select) {
      padding-inline-start: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.375rem);
    }
    .social-icons::after {
      width: 1px;
      height: 1.4rem;
      background: var(--draupnir-line-strong);
      content: '';
    }

    @media (width >= 72rem) {
      .draupnir-header-shell { grid-template-columns: minmax(8rem, auto) minmax(0, 1fr) auto auto; }
      .draupnir-primary-nav { display: flex; }
    }

    @media (width < 50rem) {
      .draupnir-header-shell { grid-template-columns: minmax(0, 1fr) auto; }
      .draupnir-header-search { width: auto; }
    }
  }
</style>
